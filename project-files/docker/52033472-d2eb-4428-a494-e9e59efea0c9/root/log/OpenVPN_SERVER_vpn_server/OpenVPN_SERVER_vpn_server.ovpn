dev tun
persist-tun
persist-key
data-ciphers-fallback AES-256-CBC
auth SHA256
client
resolv-retry infinite
remote 10.20.22.194 1194 udp
lport 0
verify-x509-name "C=PT, ST=Lisboa, O=Redes2project, CN=vpn-server" subject
remote-cert-tls server
auth-user-pass
comp-lzo no
pkcs12 OpenVPN_SERVER_vpn_server.p12
tls-auth OpenVPN_SERVER_vpn_server-tls.key 1